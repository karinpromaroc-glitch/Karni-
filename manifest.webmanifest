{
  "name": "Karni Pro",
  "short_name": "Karni",
  "description": "نظام إدارة الكرني الذكي لإدارة العملاء والدفعات والتقارير.",
  "id": "/",
  "lang": "ar",
  "dir": "rtl",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "browser"
  ],
  "orientation": "portrait",
  "theme_color": "#0f766e",
  "background_color": "#0f766e",
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "handle_links": "preferred",
  "edge_side_panel": {
    "preferred_width": 400
  },
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "الصفحة الرئيسية",
      "short_name": "الرئيسية",
      "description": "عرض لوحة التحكم والعملاء",
      "url": "/index.html",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "العملاء",
      "short_name": "العملاء",
      "description": "إدارة قائمة العملاء والكرني",
      "url": "/index.html?shortcut=customers",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "التقارير",
      "short_name": "التقارير",
      "description": "عرض التقارير والفواتير",
      "url": "/reports.html",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "المتجر",
      "short_name": "المتجر",
      "description": "إدارة المنتجات والطلبات",
      "url": "/matjar.html",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "/screenshot-1.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "لوحة تحكم Karni Pro"
    },
    {
      "src": "/screenshot-2.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "إدارة العملاء والتقارير"
    }
  ],
  "categories": [
    "business",
    "productivity",
    "finance"
  ],
  "prefer_related_applications": false
}
